# ВАЖНО: репозиторий публичный. Сюда не должно попасть ничего,
# кроме самого сайта. Особенно — внутренние документы по продаже.

# Все внутренние заметки: ЗАПУСК, СТРАТЕГИЯ-ПРОДАЖИ, ЧТО-СКАЗАТЬ-ДМИТРИЮ,
# ЗВОНОК-ДМИТРИЮ и любые будущие. Правило по маске, чтобы не забыть добавить
# новый файл руками — на этом уже один раз обожглись.
*.md

# Служебные скрипты сбора данных и деплоя
_*

# Оригиналы фото: сайт использует сжатые версии из img/web и img/stories/web
img/*.jpg
img/stories/*.jpg

# Сторис, не используемые на сайте: st2 — отзыв на русском,
# st3 — в кадре лицо ребёнка
img/stories/web/st2.*
img/stories/web/st3.*

# Исходники видео: на сайте только сжатый hero-web.mp4
video/*.mp4
!video/hero-web.mp4
