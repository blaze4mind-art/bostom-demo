# служебные скрипты сбора данных — в публикацию не нужны
_download_img.ps1
_download_stories.ps1
_optimize_img.py
_optimize_stories.py
_capture_server.py

# оригиналы фото: сайт использует сжатые версии из img/web и img/stories/web.
# Шаблоны без ** не задевают подпапки, поэтому web/ попадёт в репозиторий.
img/*.jpg
img/stories/*.jpg

# сторис, которые на сайте не используются: st2 — отзыв на русском,
# st3 — в кадре лицо ребёнка. В публичный репозиторий их класть незачем.
img/stories/web/st2.*
img/stories/web/st3.*

# внутренние документы — не для публичного репозитория
ЗАПУСК.md
СТРАТЕГИЯ-ПРОДАЖИ.md
ЧТО-СКАЗАТЬ-ДМИТРИЮ.md
